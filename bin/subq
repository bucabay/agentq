#!/usr/bin/env bash
# subq — thin shim so the submission ledger works from anywhere and from launchd's minimal PATH.
set -euo pipefail
AGENTQ_HOME="${AGENTQ_HOME:-$HOME/code/agents}"

# launchd hands a job almost no environment, and `pg` derives the Postgres role from PGUSER/USER.
# With neither set the connection goes out with an empty user name and fails at the server —
# which would look like "the ledger is down" at 03:23 rather than "the env was empty".
export PGUSER="${PGUSER:-${USER:-$(id -un)}}"

if ! command -v node >/dev/null 2>&1; then
  [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
fi
NODE="$(command -v node || echo /Users/gabe/.nvm/versions/node/v25.0.0/bin/node)"

exec "$NODE" "$AGENTQ_HOME/src/subq.mjs" "$@"
