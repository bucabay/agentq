#!/usr/bin/env bash
# agentq-schedule — install or remove a durable hourly trigger for a project.
#
#   agentq-schedule install <project> [--minute N]
#   agentq-schedule remove  <project>
#   agentq-schedule list
#
# Writes a launchd agent that runs `agentq-shift <project>`. launchd survives logout, reboot and
# any Claude session ending, which is the whole point — the in-session cron did not.
set -euo pipefail
AGENTQ_HOME="${AGENTQ_HOME:-$HOME/code/agents}"
ACTION="${1:-}"; PROJECT="${2:-}"
label_for() { echo "dev.agentq.$1"; }
plist_for() { echo "$HOME/Library/LaunchAgents/$(label_for "$1").plist"; }

case "$ACTION" in
  install)
    [ -n "$PROJECT" ] || { echo "usage: agentq-schedule install <project> [--minute N]" >&2; exit 2; }
    MINUTE=23
    [ "${3:-}" = "--minute" ] && MINUTE="${4:?minute}"
    # A project must be registered with a path before it can be scheduled. A trigger with no
    # working directory fires into nowhere, and finding that out at 03:23 is worse than now.
    PROJECT_PATH="$("$AGENTQ_HOME/bin/agentq" project show --name "$PROJECT" --json 2>/dev/null \
      | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).path??"")}catch{console.log("")}})')"
    if [ -z "$PROJECT_PATH" ]; then
      echo "project \"$PROJECT\" is not registered with a path." >&2
      echo "  agentq project add --name $PROJECT --path /abs/path" >&2
      exit 1
    fi
    [ -d "$PROJECT_PATH" ] || { echo "project path does not exist: $PROJECT_PATH" >&2; exit 1; }
    if [ ! -f "$AGENTQ_HOME/projects/$PROJECT/prompt.md" ] && [ ! -f "$PROJECT_PATH/.agentq/prompt.md" ] && [ ! -f "$AGENTQ_HOME/prompts/$PROJECT.md" ]; then
      echo "no prompt for \"$PROJECT\". Create $AGENTQ_HOME/projects/$PROJECT/prompt.md or $PROJECT_PATH/.agentq/prompt.md" >&2
      exit 1
    fi

    LABEL="$(label_for "$PROJECT")"; PLIST="$(plist_for "$PROJECT")"
    mkdir -p "$HOME/Library/LaunchAgents" "$AGENTQ_HOME/logs"
    cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agentq durable trigger for "$PROJECT".
     The shift claims from the queue FIRST and exits without invoking Claude when there is no work,
     so an idle hour costs one Postgres query.
     Remove with: agentq-schedule remove $PROJECT -->
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$AGENTQ_HOME/bin/agentq-shift</string>
    <string>$PROJECT</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>$MINUTE</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>$AGENTQ_HOME/logs/$PROJECT-launchd.out.log</string>
  <key>StandardErrorPath</key><string>$AGENTQ_HOME/logs/$PROJECT-launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>AGENTQ_HOME</key><string>$AGENTQ_HOME</string></dict>
</dict>
</plist>
PLISTEOF
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "installed $LABEL — hourly at :$MINUTE"
    echo "  project: $PROJECT_PATH"
    echo "  plist: $PLIST"
    echo "  logs:  $AGENTQ_HOME/logs/$PROJECT-*.log"
    ;;

  remove)
    [ -n "$PROJECT" ] || { echo "usage: agentq-schedule remove <project>" >&2; exit 2; }
    PLIST="$(plist_for "$PROJECT")"
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    echo "removed $(label_for "$PROJECT")"
    ;;

  list)
    launchctl list | grep -E 'dev\.agentq\.' || echo "no agentq schedules loaded"
    ;;

  *)
    echo "usage: agentq-schedule {install <project> [--minute N] | remove <project> | list}" >&2
    exit 2
    ;;
esac
